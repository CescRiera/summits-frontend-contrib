# Enforce LF line endings for shell scripts and critical iOS files
*.sh text eol=lf
*.xcconfig text eol=lf
Podfile text eol=lf
Podfile.lock text eol=lf

# PBXProj needs special treatment to avoid merge conflicts sometimes, but structure matters
*.pbxproj text eol=lf

# Other web files appropriate for LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
