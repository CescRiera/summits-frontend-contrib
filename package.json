{
  "name": "cimsweb",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:capacitor": "tsc -b && cross-env BUILD_TARGET=capacitor vite build",
    "cap:build:sync": "npm run build:capacitor && npx cap sync",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "prefix:desktop:dry": "node scripts/prefix-desktop.cjs --dry-run",
    "prefix:desktop": "node scripts/prefix-desktop.cjs --confirm",
    "check:translations": "node scripts/check-translations.mjs",
    "find:unused-translations": "node scripts/find-unused-translations.mjs",
    "find:colors": "node scripts/find-colors.mjs",
    "cap:init": "npx cap init Summits com.summitstracker.summits --web-dir=dist",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
