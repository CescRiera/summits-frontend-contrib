    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.8",
    "@mui/material": "^7.2.0",
    "@silk-hq/components": "^0.9.12",
    "@tanstack/react-query": "^5.87.1",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.5",
    "@types/react-datepicker": "^6.2.0",
    "axios": "^1.11.0",
